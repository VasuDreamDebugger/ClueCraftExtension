{
  "manifest_version": 3,
  "name": "ClueCraft",
  "version": "1.0.0",
  "description": "Chrome extension providing AI-driven hints on LeetCode problems. Get step-by-step help to boost problem-solving skills effectively.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "index.html"
  },
  "icons": {
    "16": "src/assets/bot.png",
    "32": "src/assets/bot.png",
    "48": "src/assets/bot.png",
    "128": "src/assets/bot.png"
  },

  "content_scripts": [
    {
      "js": ["src/content.tsx"],
      "matches": [
        "https://leetcode.com/*",
        "https://*.learnflow.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://localhost/*",
        "https://127.0.0.1/*"
      ]
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  }
}
